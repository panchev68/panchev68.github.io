
digraph CompositePattern {
    node [shape=record, fontname=Helvetica, fontsize=10];
    Component [label="{Component|+ operation() : void}"];
    Leaf [label="{Leaf|+ operation() : void}"];
    Composite [label="{Composite|+ add(Component* component) : void|+ operation() : void|children_ : std::vector<Component*>}"];

    Component -> Leaf;
    Component -> Composite;
    Composite -> Component [arrowhead=none, label="children_"];
}
