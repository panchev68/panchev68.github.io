
digraph FlyweightPattern {
    node [shape=record, fontname=Helvetica, fontsize=10];
    FlyweightFactory [label="{FlyweightFactory|+ getFlyweight(sharedState: std::string) : Flyweight*|+ ~FlyweightFactory()}"];
    Flyweight [label="{Flyweight|+ Flyweight(sharedState: std::string)|+ operation(uniqueState: std::string) const|sharedState_: std::string}"];
    Client [label="{Client|+ main()}"];

    Client -> FlyweightFactory [label="uses"];
    FlyweightFactory -> Flyweight [label="creates"];
}
