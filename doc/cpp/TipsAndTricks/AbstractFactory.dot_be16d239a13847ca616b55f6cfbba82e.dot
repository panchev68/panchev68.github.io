digraph AbstractFactory {
    rankdir=LR;
    size="8,5";
    bgcolor=0x00000000;
    label="Abstract Factory Pattern";
    labelloc=top;

    node [style=filled, fillcolor=lightgrey, shape=record];
    edge [color=white, fontcolor=white];

    AbstractFactory [label="AbstractFactory|+createProductA()\l+createProductB()"];
    ConcreteFactory1 [label="ConcreteFactory1|+createProductA()\l+createProductB()"];
    ConcreteFactory2 [label="ConcreteFactory2|+createProductA()\l+createProductB()"];
    AbstractProductA [label="AbstractProductA|+operationA()"];
    AbstractProductB [label="AbstractProductB|+operationB()"];
    ConcreteProductA1 [label="ConcreteProductA1|+operationA()"];
    ConcreteProductA2 [label="ConcreteProductA2|+operationA()"];
    ConcreteProductB1 [label="ConcreteProductB1|+operationB()"];
    ConcreteProductB2 [label="ConcreteProductB2|+operationB()"];

    ConcreteFactory1 -> AbstractFactory [arrowhead="onormal"];
    ConcreteFactory2 -> AbstractFactory [arrowhead="onormal"];
    ConcreteProductA1 -> AbstractProductA [arrowhead="onormal"];
    ConcreteProductA2 -> AbstractProductA [arrowhead="onormal"];
    ConcreteProductB1 -> AbstractProductB [arrowhead="onormal"];
    ConcreteProductB2 -> AbstractProductB [arrowhead="onormal"];

    AbstractFactory -> AbstractProductA [label="createProductA()"];
    AbstractFactory -> AbstractProductB [label="createProductB()"];
    ConcreteFactory1 -> ConcreteProductA1 [label="createProductA()"];
    ConcreteFactory1 -> ConcreteProductB1 [label="createProductB()"];
    ConcreteFactory2 -> ConcreteProductA2 [label="createProductA()"];
    ConcreteFactory2 -> ConcreteProductB2 [label="createProductB()"];
}
