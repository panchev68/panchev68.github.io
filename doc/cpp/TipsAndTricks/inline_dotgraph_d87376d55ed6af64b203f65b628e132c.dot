
digraph FactoryMethod {
    node [shape=record, fontname=Helvetica, fontsize=10];
    Product [label="{Product|+ use() : void}"];
    ConcreteProductA [label="{ConcreteProductA|+ use() : void}"];
    ConcreteProductB [label="{ConcreteProductB|+ use() : void}"];
    Creator [label="{Creator|+ factoryMethod() : Product*\\l+ someOperation() : void}"];
    ConcreteCreatorA [label="{ConcreteCreatorA|+ factoryMethod() : Product*}"];
    ConcreteCreatorB [label="{ConcreteCreatorB|+ factoryMethod() : Product*}"];

    Creator -> Product [arrowhead="empty", style="dashed"];
    ConcreteProductA -> Product;
    ConcreteProductB -> Product;
    ConcreteCreatorA -> Creator;
    ConcreteCreatorB -> Creator;
}
